DATABASE_URL=file:/home/z/my-project/db/custom.db

# ── Google OAuth (server-side only — never expose these to the browser) ──
# Fill in the values from Google Cloud Console (APIs & Services → Credentials).
# While these are empty, the "Sign in with Google" button shows a clear
# "not configured" message and email/password login is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override for the OAuth redirect URI. Leave empty to derive it from
# the request host (http://localhost:3000/api/auth/google/callback in dev).
# Set it explicitly when running behind the Z.ai preview proxy, e.g.:
#   GOOGLE_REDIRECT_URI=https://preview-chat-<id>.space-z.ai/api/auth/google/callback
GOOGLE_REDIRECT_URI=

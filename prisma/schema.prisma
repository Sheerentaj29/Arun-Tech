// Equipment Master Management - Industrial Inspection Report Automation System
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================================================
// AUTH & USERS
// =====================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("EMPLOYEE") // ADMIN | EMPLOYEE | INSPECTOR | APPROVER (INSPECTOR/APPROVER treated as Employee for routing)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  equipment           Equipment[]           @relation("EquipmentCreatedBy")
  inspections         Inspection[]
  auditLogs           AuditLog[]
  pipelineInspections PipelineInspection[]  @relation("PipelineInspectionInspector")
  approvedReports     PipelineInspection[]  @relation("PipelineInspectionApprover")
  returnedReports     PipelineInspection[]  @relation("PipelineInspectionReturnedBy")
  pipeStandardEdits   PipeStandard[]        @relation("PipeStandardVerifiedBy")
  revisedReports      ReportRevision[]      @relation("ReportRevisionRevisedBy")
  approvedRevisions   ReportRevision[]      @relation("ReportRevisionApprovedBy")
}

// =====================================================
// CLIENTS & PLANTS
// =====================================================

model Client {
  id           String   @id @default(cuid())
  name         String   @unique
  industry     String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  address      String?
  logoPath     String?
  notes        String?
  isDemo       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  plants               Plant[]
  equipment            Equipment[]
  pipelineInspections  PipelineInspection[]
  engineeringDrawings  EngineeringDrawing[]
}

model Plant {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  location  String?
  address   String?
  notes     String?
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  equipment Equipment[]
  pipelineInspections PipelineInspection[]
  engineeringDrawings  EngineeringDrawing[]
}

// =====================================================
// EQUIPMENT MASTER
// =====================================================

model Equipment {
  id                String   @id @default(cuid())
  equipmentId       String   // human-readable unique ID, e.g. EQ-001
  name              String
  category          String   // STORAGE | PRESSURE | SEPARATION | UTILITY | PIPE | VALVE | PUMP | OTHER
  type              String   // e.g. "Chemical Storage Tank"
  orientation       String?  // Horizontal | Vertical | Inclined | Not Applicable

  // Dimensional data — nullable because not every field applies to every type.
  diameter          Float?   // mm
  height            Float?   // mm
  length            Float?   // mm
  width             Float?   // mm
  capacity          Float?   // m3
  wallThickness     Float?   // mm
  // Pipe / heat-exchanger specific
  nominalDiameter   Float?   // mm (DN)
  outsideDiameter   Float?   // mm (OD)
  tubeLength        Float?   // mm (heat exchanger)
  shellDiameter     Float?   // mm (heat exchanger)

  material          String?
  manufacturer      String?
  serialNumber      String?

  clientId          String
  plantId           String
  tagNumber         String?
  dimensionSource   String?  // Approved Engineering Drawing | Manufacturer Drawing | Nameplate | Field Measurement
  verificationStatus String   @default("Unverified") // Verified | Unverified

  isDemo            Boolean  @default(false)
  notes             String?

  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client     Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plant      Plant        @relation(fields: [plantId], references: [id], onDelete: Cascade)
  createdBy  User         @relation("EquipmentCreatedBy", fields: [createdById], references: [id])
  inspections Inspection[]
  engineeringDrawings  EngineeringDrawing[]

  @@unique([clientId, equipmentId])
  @@index([clientId])
  @@index([plantId])
  @@index([category])
  @@index([type])
}

// =====================================================
// INSPECTIONS
// =====================================================

model Inspection {
  id              String   @id @default(cuid())
  equipmentId     String
  inspectorId     String
  inspectionDate  DateTime
  inspectionType  String   // Visual | UT Thickness | Penetrant | Radiography | Pressure Test | Other
  status          String   @default("Completed") // Scheduled | In-Progress | Completed | Failed
  summary         String?
  observations    String?
  // Free-form recorded measurements as JSON: [{label, value, unit, notes}]
  measurements    String?
  photoCount      Int      @default(0)
  reportPath      String?
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  inspector User      @relation(fields: [inspectorId], references: [id])

  @@index([equipmentId])
  @@index([inspectorId])
}

// =====================================================
// AUDIT LOG
// =====================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String   // CREATE | UPDATE | DELETE | LOGIN | EXPORT | IMPORT | APPROVE | OVERRIDE
  entity    String   // Equipment | Client | Plant | Inspection | User | PipelineInspection | PipeStandard | ComponentType
  entityId  String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([userId])
}

// =====================================================
// PIPE STANDARD REFERENCE DATA (ASME B36.10M / B36.19M)
// =====================================================
// Wall thickness values seeded from the publicly published ASME
// reference tables for the most commonly used nominal pipe sizes and
// schedules. These values MUST be re-verified against the licensed /
// official ASME standard edition by an authorized administrator before
// production use. An admin can edit, add, or delete entries, and every
// edit is recorded with verifiedBy + verifiedAt + audit log entry.

model PipeStandard {
  id              String   @id @default(cuid())
  standard        String   // "ASME B36.10M" | "ASME B36.19M"
  edition         String   // e.g. "2018"
  nominalSizeInch String   // e.g. "2" or "1/2"
  nominalSizeMm   Float   // e.g. 60.3
  dn              String   // e.g. "DN50"
  schedule        String   // e.g. "SCH 40", "STD", "XS", "XXS", "SCH 40S"
  wallThicknessMm Float   // nominal wall thickness in mm
  oD_mm           Float?   // outside diameter (mm) when applicable
  isVerified      Boolean  @default(false)
  verifiedById    String?
  verifiedAt      DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  verifiedBy      User?    @relation("PipeStandardVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  measurements    ThicknessMeasurement[]

  @@unique([standard, edition, nominalSizeInch, schedule])
  @@index([standard, nominalSizeInch])
}

// =====================================================
// COMPONENT TYPES (editable dropdown)
// =====================================================
// PIPE, ELBOW, TEE, REDUCER, FLANGE, OTHER. Admin-extensible.

model ComponentType {
  id        String   @id @default(cuid())
  code      String   @unique // PIPE, ELBOW, TEE, REDUCER, FLANGE, OTHER
  label     String   // display label
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thicknessMeasurements ThicknessMeasurement[]
}

// =====================================================
// PIPELINE INSPECTION REPORT
// =====================================================
// A single UT thickness measurement report on a pipeline section.
// Header captures client/plant/pipeline identity; rows are individual
// measurement points (ThicknessMeasurement).

model PipelineInspection {
  id                       String   @id @default(cuid())
  reportNumber             String   // human-readable report number, e.g. "UT-COR-ENN-001"
  // ─── Report type selector ───
  // PIPELINE_THICKNESS  → Pipeline Thickness Measurement Report (existing)
  // PIPELINE_VISUAL     → Pipeline Visual Inspection Report
  // PIPELINE_CONDITION  → Pipeline Inspection / Condition Assessment Report
  // PIPELINE_DPT        → DPT / DPPT Dye Penetrant Testing Report
  // Existing rows get the default (PIPELINE_THICKNESS) so no data is lost.
  reportType               String   @default("PIPELINE_THICKNESS")
  clientId                 String
  plantId                  String
  inspectionArea           String?  // free text / searchable
  pipelineDescription      String?  // free text / searchable
  pipelineIdentificationNumber String? // free text / searchable
  isometricDrawingNumber   String? // free text / searchable
  materialOfConstruction   String? // e.g. Carbon Steel, SS316
  applicableStandard       String? // e.g. "ASME B36.10M"
  standardEdition          String? // e.g. "2018"

  inspectionDate           DateTime @default(now()) // preserved for backward compat
  fromDate                 DateTime? // Start date of inspection/service activity
  toDate                   DateTime?   // End date of inspection/service activity
  primaryPhotoPath         String?  // Path to the primary inspection photo (pipeline/vessel/equipment)
  // Approval workflow statuses:
  //   Draft                  — employee is still editing the report
  //   Submitted for Review    — employee has submitted; waiting for admin
  //   Returned for Revision   — admin returned with comments; employee must fix and resubmit
  //   Approved                — admin approved; PDF is the current approved version
  //   Changes Pending Review  — employee edited an Approved report; new revision pending admin review
  status                   String   @default("Draft")
  revisionNumber           Int      @default(1)

  inspectorId              String
  inspectorName            String   // editable — inspector's name as typed by the user
  approvedByName           String?  // editable — approver's name as typed by the user (also auto-filled during approval if empty)
  findingsSummary          String?  // overall findings section
  comments                 String?  // general comments
  // Large multiline inspection description for Step 3 of the form
  inspectionDescription     String?
  // Custom column definitions stored as JSON: [{id, name, unit}]
  // These are user-added columns beyond the 11 default system columns.
  customColumns            String?

  // ─── Multi-table grouping (additive, optional) ───
  // JSON array describing every Thickness table in this report:
  //   [{ "id": "default", "label": "Thickness Pipeline Table 1", "sortOrder": 0 },
  //    { "id": "t_1700000000000", "label": "Thickness Pipeline Table 2", "sortOrder": 1 }]
  // Null/empty → single default table (legacy behaviour). Each row in
  // ThicknessMeasurement carries a `tableGroup` matching one of these ids.
  thicknessTablesConfig    String?
  // Photos stored as JSON array (legacy): [{path, caption, uploadedAt}]
  // Also tracked individually via the ReportPhoto model below for
  // proper relational storage and retrieval.
  photos                   String?

  // Override tracking (admin-approved nominal thickness override)
  overrideReason           String?
  overrideAppliedById      String?
  overrideAppliedAt        DateTime?

  // Approval tracking (when admin approves)
  approvedById             String?
  approvedAt               DateTime?
  approvalNotes            String?

  // Return-for-revision tracking (when admin returns the report)
  returnedById             String?
  returnedAt               DateTime?
  reviewComments           String?  // mandatory when admin returns for revision

  // Pointer to the currently-approved revision (when status=Approved or
  // Changes Pending Review). Null when the report has never been approved.
  currentApprovedRevisionId String?

  // PDF artifact (generated PDF path) — always reflects the latest revision
  pdfPath                  String?
  signedPdfPath            String?

  // ─── PIPELINE CONDITION ASSESSMENT fields ───
  // Single-instance per report (no child rows needed). Populated when
  // reportType = PIPELINE_CONDITION. Stored as nullable scalars so the
  // existing thickness-measurement workflow is not affected.
  pipelineAgeYears         Float?   // Pipeline Age, if available
  serviceFluid             String?  // Service / Fluid
  operatingCondition       String?  // Operating Condition (Normal / Elevated / Cyclic / etc.)
  overallConditionRating   String?  // Overall Condition Rating (Excellent / Good / Fair / Poor)
  corrosionCondition       String?  // Corrosion Condition (free text)
  damageAssessment         String?  // Damage Assessment (free text)
  previousInspectionRef    String?  // Previous Inspection Reference (report no / date)
  currentInspectionFindings String? // Current Inspection Findings (free text, multi-line)
  riskPriorityLevel        String?  // Risk / Priority Level (Low / Medium / High / Critical)
  recommendations          String?  // Recommendations (free text, multi-line)
  nextInspectionRecommendation String? // Next Inspection Recommendation

  // ─── NEW REPORT SECTIONS (all report types) ───
  // These appear after the measurement/observation data and before the
  // inspection photos in the final PDF. They are editable in the form
  // (Step 4: Findings & Photos) and visible during review.
  siteObservationSummary   String?  // Summary of Site Observations
  results                  String?  // Results
  conclusion               String?  // Conclusion

  // ─── SIGN-OFF FIELDS ───
  // The existing inspectorName / approver fields are preserved.
  // New fields for the three-signatory sign-off:
  //   Inspected By → inspectorName (existing) + inspectorDesignation (new)
  //   Second Reviewed By → secondReviewedByName + secondReviewedByDesignation + secondReviewedAt
  //   Approved By → approver.name (existing) + approvedByDesignation (new) + approvedAt (existing)
  inspectorDesignation       String?  // Designation of the inspector
  secondReviewedById         String?  // User who did the second review
  secondReviewedByName       String?  // Name snapshot
  secondReviewedByDesignation String? // Designation
  secondReviewedAt           DateTime? // Date of second review
  approvedByDesignation      String?  // Designation of the approver

  // ─── DPT / DPPT REPORT FIELDS ───
  // Populated when reportType = PIPELINE_DPT
  dptDateOfExamination       DateTime? // Date of Examination (editable)
  dptSolventCleaner          String?  // Solvent / Cleaner material used (Consumable Details)
  dptPenetrant               String?  // Penetrant material used (Consumable Details)
  dptDeveloper               String?  // Developer material used (Consumable Details)
  dptCustomColumns           String?  // JSON: [{id, name, unit}] custom columns for DPT table

  // ─── DYE PENETRANT PROCEDURE FIELDS ───
  // Populated when reportType = PIPELINE_DPT. Two-column "DYE PENETRANT
  // PROCEDURE" section in the PDF, with the field name on the left and
  // the editable value on the right. All values are typeable/editable.
  dptTestingStandard                String? // Testing Standard
  dptAcceptanceCriteria             String? // Acceptance Criteria
  dptSurfacePreparation             String? // Surface Preparation
  dptSurfaceTemperature             String? // Surface Temperature
  dptPenetrantType                  String? // Penetrant Type
  dptPenetrantProcess               String? // Penetrant Process
  dptMethodOfPreCleaning            String? // Method of Pre-cleaning
  dptDryingTimeAfterPreCleaning     String? // Drying Time After Pre-cleaning
  dptMethodOfApplyingPenetrant      String? // Method of Applying Penetrant
  dptPenetratingTime                String? // Penetrating Time
  dptMethodOfRemovingExcessPenetrant String? // Method of Removing Excess Penetrant
  dptMethodOfApplyingDeveloper      String? // Method of Applying Developer
  dptDevelopmentTime                String? // Development Time
  dptInterpretationTime             String? // Interpretation Time
  dptLightingEquipment              String? // Lighting Equipment
  dptPostCleaning                   String? // Post Cleaning

  // ─── MPT (MAGNETIC PARTICLE TESTING) PROCEDURE FIELDS ───
  // Populated when reportType = PIPELINE_MPT. Two-column
  // "MAGNETIC PARTICLE TESTING PARAMETERS" section in the PDF.
  // All values are typeable/editable unless noted.
  mptDateOfExamination              DateTime? // Date of Examination (calendar picker)
  mptTestingStandard                String? // Testing Standard
  mptAcceptanceCriteria             String? // Acceptance Criteria
  mptSurfacePreparation             String? // Surface preparation
  mptSurfaceTemperature             String? // Surface temperature
  mptInstrumentSerialNo             String? // Type of Instrument / SI.No
  mptCalibrationDate                DateTime? // Instrument / Calibration Date (calendar picker)
  mptMethod                         String? // MPT Method
  mptTypeOfCurrent                  String? // Type of Current
  mptAcYokeLiftingCapacity          String? // AC Yoke Lifting Capacity
  mptContrastMedium                 String? // Contrast Medium
  mptMethodOfPreCleaning            String? // Method of Pre cleaning
  mptMethodOfApplyingWhiteContrast  String? // Method of applying White Contrast
  mptAcYokePoleSpacing              String? // AC Yoke Pole Spacing
  mptMagneticMedium                 String? // Magnetic Medium
  mptMethodOfApplyingMagneticMedium String? // Method of applying Magnetic Medium
  mptDevelopmentTime                String? // Development time
  mptInterpretationTime             String? // Interpretation time
  mptLightingEquipment              String? // Lightning Equipment
  mptPostCleaning                   String? // Post cleaning
  // MPT Consumable Details
  mptWhiteContrast                  String? // White Contrast (consumable)
  mptWetParticleIronInk             String? // Wet Particle Iron Ink (consumable)
  // MPT custom columns for the observation table
  mptCustomColumns                  String?  // JSON: [{id, name, unit}]

  // ─── UT (ULTRASONIC TEST) REPORT FIELDS ───
  // Populated when reportType = PIPELINE_UT. UT-specific header fields
  // stored directly on the report. Multi-row tables (equipment, probes,
  // test results) are stored as JSON strings.
  utSubContract                     String?  // Sub Contract
  utProject                         String?  // Project
  utJobLocation                     String?  // Job Location
  utJobDescription                  String?  // Job Description
  utMaterial                        String?  // Material
  utCouplant                        String?  // Couplant
  utReferenceDocuments              String?  // Reference Documents
  utProcedureNo                     String?  // UT Procedure No.
  utAcceptanceStandard              String?  // Acceptance Standard
  utUfdDetails                      String?  // UFD Details (multiline text)
  // Scanning details (single-instance fields)
  utCalibrationBlock                String?  // Calibration Block (DAC Block)
  utExtentOfExamination             String?  // Extent of Examination
  utSurfaceCondition                String?  // Surface Condition
  utReferenceLevel                  String?  // Reference Level
  utFlawSizingTechnique             String?  // Flaw Sizing Technique
  utInspectionNote                  String?  // Inspection note (multiline, below Test Results)
  // Multi-row tables stored as JSON
  utEquipmentRows                   String?  // JSON: [{equipmentType, machineMake, model, mcSrNo, calibrationDueDate}]
  utProbeRows                       String?  // JSON: [{probeType, probeAngle, frequency, size, probeNo, range, referenceDb, scanningDb}]
  utTestResultRows                  String?  // JSON: [{description, beamId, noOfJoints, thickness, weldType, moc, totalMeter, results}]
  utCustomColumns                   String?  // JSON: [{id, name, unit}] (reserved for future)

  // ─── WELD SCAN SPECIFIC FIELDS ───
  // Populated when reportType = PIPELINE_WELD_SCAN. Stored as JSON strings.
  // Multi-row tables for instrument details, probe details, and test results.
  wsScanningCalibrationBlock        String?  // Calibration Block (typeable)
  wsScanningReferenceLevel          String?  // Reference Level (typeable)
  wsScanningExtentOfExamination     String?  // Extent of Examination (typeable)
  wsScanningSurfaceCondition        String?  // Surface Condition (dropdown)
  wsScanningFlawSizingTechnique     String?  // Flaw Sizing Technique (dropdown)
  wsInstrumentRows                  String?  // JSON: [{equipmentType, machineMake, model, mcSrNo, calibrationDueDate}]
  wsProbeRows                       String?  // JSON: [{probeType, probeAngle, frequency, size, probeNo, range, referenceDb, scanningDb}]
  wsTestResultRows                  String?  // JSON: [{description, identificationNo, weldType, probe, bp, sd, depth, echoHeight, length, observation, result}]

  // ─── EQUIPMENT TYPE + VESSEL FIELDS ───
  // equipmentType records the selection made in the report-creation flow
  // ("PIPING" or "VESSEL"). Null for legacy rows created before this
  // field existed. vesselOrientation is required for VESSEL_DPT reports
  // ("HORIZONTAL" or "VERTICAL") and is displayed on the review page and
  // in the generated PDF.
  equipmentType             String?  // PIPING | VESSEL
  vesselOrientation         String?  // HORIZONTAL | VERTICAL (VESSEL_DPT only)

  // ─── VESSEL DPT CONSUMABLE DETAILS ───
  // Populated when reportType = VESSEL_DPT. Separate Make / Product /
  // Batch Number / Expiry Date entry for each of the three consumables.
  // All typeable text (expiry dates are free text, e.g. "Nov-2027").
  vdptSolventMake           String?  // Solvent — Make
  vdptSolventProduct        String?  // Solvent — Product / Description
  vdptSolventBatchNo        String?  // Solvent — Batch Number
  vdptSolventExpiry         String?  // Solvent — Expiry Date
  vdptPenetrantMake         String?  // Penetrant — Make
  vdptPenetrantProduct      String?  // Penetrant — Product / Description
  vdptPenetrantBatchNo      String?  // Penetrant — Batch Number
  vdptPenetrantExpiry       String?  // Penetrant — Expiry Date
  vdptDeveloperMake         String?  // Developer — Make
  vdptDeveloperProduct      String?  // Developer — Product / Description
  vdptDeveloperBatchNo      String?  // Developer — Batch Number
  vdptDeveloperExpiry       String?  // Developer — Expiry Date

  isDemo                   Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plant       Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inspector   User        @relation("PipelineInspectionInspector", fields: [inspectorId], references: [id])
  approver    User?       @relation("PipelineInspectionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  returnedBy  User?       @relation("PipelineInspectionReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  measurements ThicknessMeasurement[]
  visualObservations VisualInspectionObservation[]
  dptObservations DptObservation[]
  revisions   ReportRevision[]
  reportPhotos ReportPhoto[]
  drawingLinks DrawingInspectionLink[]
  certificates InspectionCertificate[]

  @@unique([clientId, reportNumber])
  @@index([clientId])
  @@index([plantId])
  @@index([inspectorId])
  @@index([status])
  @@index([reportType])
}

// =====================================================
// THICKNESS MEASUREMENT ROW
// =====================================================
// One row per measurement point. The first two columns (Dia mm (inch),
// Pipe Schedule) are stored as structured values; the third column
// (Nominal Thickness) is calculated from PipeStandard and may be
// overridden only with a recorded reason. The four clock-position
// measurements support an explicit status (Measured | NotMeasured |
// NotApplicable) so missing data is never converted to zero.

model ThicknessMeasurement {
  id                    String   @id @default(cuid())
  pipelineInspectionId String
  pointNo               String   // free text, e.g. "P-1"
  sortOrder             Int      @default(0)

  // ─── Multi-table grouping (additive, default "default") ───
  // When a Thickness report contains multiple tables, each row belongs to
  // exactly one table group. Existing rows (and any new row in a
  // single-table report) get "default" — so the existing single-table
  // workflow keeps working unchanged. The list of table groups itself is
  // stored as JSON on the parent PipelineInspection.thicknessTablesConfig.
  tableGroup            String   @default("default")

  // First two fixed columns
  pipeSizeInch          String   // e.g. "2", "1/2", "6" (matches PipeStandard.nominalSizeInch)
  pipeSchedule          String   // e.g. "SCH 40", "STD"

  // Third column (calculated from standards; override captured separately)
  nominalThicknessMm    Float?   // snapshot from PipeStandard at row creation/update
  nominalOverride       Float?   // authorized override value (with reason at report level)
  standardId            String?  // FK to PipeStandard used to compute nominalThicknessMm

  // Fourth column
  componentTypeId        String?
  componentTypeCode      String   // snapshot code (PIPE | ELBOW | TEE | REDUCER | FLANGE | OTHER)

  // Columns 5-9: clock-position measurements with explicit status
  northMm               Float?
  northStatus            String   @default("NotMeasured") // Measured | NotMeasured | NotApplicable
  eastMm                 Float?
  eastStatus             String   @default("NotMeasured")
  southMm               Float?
  southStatus            String   @default("NotMeasured")
  westMm                 Float?
  westStatus             String   @default("NotMeasured")

  // Column 10: observed minimum (calculated; null if no valid measurements)
  observedMinimumMm     Float?
  observedMinimumOverride Float? // authorized override with reason

  // Column 11: findings / comments
  findingsComments      String?
  // Custom column values stored as JSON: {"col_id_1": "5.2", "col_id_2": "N/A"}
  // Each key corresponds to a custom column defined on the parent PipelineInspection.
  customColumnValues    String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pipelineInspection    PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)
  componentType         ComponentType?     @relation(fields: [componentTypeId], references: [id], onDelete: SetNull)
  standard              PipeStandard?      @relation(fields: [standardId], references: [id], onDelete: SetNull)

  @@index([pipelineInspectionId])
  @@index([pipeSizeInch, pipeSchedule])
}

// =====================================================
// VISUAL INSPECTION OBSERVATION ROW
// =====================================================
// One row per inspection point for the Pipeline Visual Inspection Report.
// Each row captures the visual condition at a distinct point/location along
// the pipeline. Photos are linked via the existing ReportPhoto model and
// can be associated with a specific observation via photoObsId below.

model VisualInspectionObservation {
  id                          String   @id @default(cuid())
  pipelineInspectionId        String
  pointNo                     String   // e.g. "V-1", "PIP-001"
  sortOrder                   Int      @default(0)
  location                    String?  // Inspection Point / Location (free text)

  // Visual inspection fields
  pipelineCondition           String?  // Pipeline Condition (Good / Fair / Poor / etc.)
  externalSurfaceCondition    String?  // External Surface Condition
  coatingPaintCondition       String?  // Coating / Paint Condition
  corrosionObserved           String?  // Corrosion Observed (None / Light / Moderate / Severe)
  leakageObserved             String?  // Leakage Observed (Yes / No / Suspected)
  damageOrDeformation         String?  // Damage or Deformation
  supportsHangersCondition    String?  // Supports and Hangers Condition
  weldJointCondition          String?  // Weld Joint Condition
  insulationCondition         String?  // Insulation Condition (if applicable)
  findings                    String?  // Findings (free text)
  recommendations             String?  // Recommendations (free text)
  inspectorComments           String?  // Inspector Comments (free text)

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  pipelineInspection          PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)

  @@index([pipelineInspectionId])
}

// =====================================================
// REPORT REVISION HISTORY
// =====================================================
// Every save of an Approved report creates a new revision snapshot.
// Earlier revisions remain accessible for audit / retrieval.

model ReportRevision {
  id                String   @id @default(cuid())
  pipelineInspectionId String
  revisionNumber    Int
  revisionDate      DateTime @default(now())
  // Each revision tracks its own status in the approval workflow:
  //   Draft | Submitted for Review | Returned for Revision | Approved | Changes Pending Review | Superseded
  // A revision is "Superseded" once a later revision is approved.
  status            String   @default("Draft")
  revisedById       String?
  revisedByName     String?
  // Snapshot of the report header at this revision (for display + audit)
  changeDescription String?
  pdfPath           String?
  snapshotData      String?  // JSON snapshot of the full report at this revision
  // Review fields (when admin reviews this specific revision)
  reviewComments    String?
  approvedById      String?
  approvedAt       DateTime?
  approvedByName   String?
  createdAt         DateTime @default(now())

  pipelineInspection PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)
  revisedBy          User?             @relation("ReportRevisionRevisedBy", fields: [revisedById], references: [id], onDelete: SetNull)
  approvedBy         User?             @relation("ReportRevisionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([pipelineInspectionId])
  @@index([status])
}

// =====================================================
// REPORT PHOTOS (persistent file storage)
// =====================================================
// Each photo is stored as a file on disk (storage/photos/) and tracked
// in this table with its filename, caption, and upload metadata.
// Photos are included in the generated PDF and preserved with approved
// report revisions.

model ReportPhoto {
  id                   String   @id @default(cuid())
  pipelineInspectionId String
  fileName             String   // original file name from upload
  filePath             String   // absolute path on disk (storage/photos/...)
  fileSize             Int      // bytes
  mimeType             String   // image/jpeg, image/png, etc.
  caption              String?  // optional: "Overall pipeline view", "Corrosion observed", etc.
  sortOrder            Int      @default(0)
  // Category: "PRIMARY" = primary inspection photo (first page of PDF),
  //           "INSPECTION" = regular inspection photo (gallery section).
  // When the primary photo is uploaded via /primary-photo, the ReportPhoto
  // row is tagged PRIMARY so it can be excluded from the Inspection
  // Photographs gallery. Regular photo uploads are tagged INSPECTION.
  category             String   @default("INSPECTION")
  uploadedById         String?
  uploadedByName       String?
  createdAt            DateTime @default(now())

  pipelineInspection PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)

  @@index([pipelineInspectionId])
  @@index([category])
}

// =====================================================
// ENGINEERING DRAWINGS
// =====================================================
// Engineering drawings (AutoCAD DWG/DXF, PDF, images) uploaded by
// admins/employees. Each drawing has metadata (title, number, type,
// revision) and one or more file revisions stored on disk.
// Drawings can be associated with clients, plants, equipment, and
// inspection reports.

model EngineeringDrawing {
  id              String   @id @default(cuid())
  title           String   // human-readable drawing title
  drawingNumber   String   // e.g. "ISO-PIPE-001"
  drawingType     String   // Plant Layout | P&ID | Isometric | Pipeline Layout | GA | Mechanical | Structural | Electrical | Instrumentation | Other
  description     String?
  
  clientId        String
  plantId         String?
  equipmentId     String?  // optional link to Equipment Master
  
  // Which revision is currently active
  activeRevisionId String?
  
  isDemo          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plant           Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  equipment       Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  revisions       DrawingRevision[]
  inspectionLinks DrawingInspectionLink[]
  
  @@unique([clientId, drawingNumber])
  @@index([clientId])
  @@index([plantId])
  @@index([equipmentId])
  @@index([drawingType])
}

model DrawingRevision {
  id              String   @id @default(cuid())
  drawingId       String
  revisionNumber  String   // "Rev 0", "Rev 1", "Rev 2", etc.
  revisionDate    DateTime @default(now())
  
  // File storage
  fileName        String   // original filename from upload
  filePath        String   // absolute path on disk (storage/drawings/...)
  fileSize        Int      // bytes
  mimeType        String   // detected MIME type
  fileExtension   String   // .dwg, .dxf, .pdf, .png, etc.
  
  // Preview (for image/PDF formats only; null for DWG/DXF)
  previewPath     String?  // path to generated preview image (if applicable)
  
  // Upload metadata
  uploadedById    String?
  uploadedByName  String?
  notes           String?
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  
  drawing         EngineeringDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  
  @@index([drawingId])
  @@index([isActive])
}

// Links drawings to specific inspection reports
model DrawingInspectionLink {
  id                      String   @id @default(cuid())
  drawingId               String
  drawingRevisionId       String?  // specific revision (null = use active)
  pipelineInspectionId    String
  attachedById            String?
  attachedByName          String?
  createdAt               DateTime @default(now())
  
  drawing                 EngineeringDrawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  pipelineInspection      PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)
  
  @@unique([drawingId, pipelineInspectionId])
  @@index([drawingId])
  @@index([pipelineInspectionId])
}

// =====================================================
// INSPECTION CERTIFICATES
// =====================================================
// Certificates uploaded for an inspection report, split into two
// categories:
//   EQUIPMENT — calibration certificates for instruments/equipment
//   PERSONNEL — certificates associated with inspectors/personnel

model InspectionCertificate {
  id                   String   @id @default(cuid())
  pipelineInspectionId String
  category             String   // "EQUIPMENT" | "PERSONNEL"
  title                String   // certificate name/title
  fileName             String   // original filename
  filePath             String   // path on disk
  fileSize             Int      // bytes
  mimeType             String   // detected MIME type
  fileExtension        String   // .pdf, .png, .jpg, .jpeg
  sortOrder            Int      @default(0)
  uploadedById         String?
  uploadedByName       String?
  createdAt            DateTime @default(now())

  pipelineInspection   PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)

  @@index([pipelineInspectionId])
  @@index([category])
}

// =====================================================
// DPT / DPPT OBSERVATION ROW
// =====================================================
// One row per DPT inspection point. Serial numbers are auto-generated
// (1, 2, 3...) and renumbered when rows are added/deleted.
// Each row has: description, weld type, result (Accept/Reject),
// remarks, and custom column values.

model DptObservation {
  id                    String   @id @default(cuid())
  pipelineInspectionId  String
  serialNo              Int      @default(1) // auto-generated sequential number
  sortOrder             Int      @default(0)

  description           String?  // Description of the inspected area/component
  weldType              String?  // Weld type (Butt Weld, Fillet Weld, etc.)
  indicationSize        String?  // Indication Size (mm) — typeable
  result                String   @default("Accept") // Accept | Reject
  remarks               String?  // Additional observations/remarks

  // Custom column values stored as JSON: {"col_id_1": "value", ...}
  customColumnValues    String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pipelineInspection    PipelineInspection @relation(fields: [pipelineInspectionId], references: [id], onDelete: Cascade)

  @@index([pipelineInspectionId])
}
